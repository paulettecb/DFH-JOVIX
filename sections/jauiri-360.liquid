{%- comment -%}
  DFH JOVIX · Jauiri 360°
  El video del frasco avanza con el scroll, cuadro por cuadro (como en
  las páginas de producto de Apple). Los cuadros son imágenes del tema:
  jauiri-360-001.webp … jauiri-360-080.webp
{%- endcomment -%}

{%- assign frames = section.settings.frames | default: 80 -%}
<section
  id="j360-{{ section.id }}"
  class="j360"
  data-frames="{{ frames }}"
>
  <div class="j360__stage">
    <picture>
      <source media="(max-aspect-ratio: 1/1)" srcset="{{ 'jauiri-360m-001.webp' | asset_url }}">
      <img class="j360__poster" src="{{ 'jauiri-360-001.webp' | asset_url }}" alt="Frasco de Jauiri girando" width="1280" height="720" loading="eager">
    </picture>
    <canvas class="j360__canvas" aria-hidden="true"></canvas>
    <div class="j360__shade" aria-hidden="true"></div>
    <div class="j360__lines">
      {%- if section.settings.eyebrow != blank -%}<p class="j360__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <div class="j360__stack">
        <h2 class="j360__line" data-l="1">{{ section.settings.line_1 }}</h2>
        <h2 class="j360__line" data-l="2">{{ section.settings.line_2 }}</h2>
      </div>
    </div>
    <div class="j360__bar" aria-hidden="true"><span></span></div>
  </div>
</section>

<style>
  .j360 { position: relative; height: 420vh; background: #050307; color: #fff; }
  .j360__stage { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; }
  .j360__poster, .j360__canvas { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .j360__canvas { opacity: 0; transition: opacity .5s ease; }
  .j360.is-ready .j360__canvas { opacity: 1; }
  .j360__shade { position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(180deg, #050307 0%, rgba(5,3,7,0) 20%, rgba(5,3,7,0) 66%, rgba(5,3,7,.9) 100%); }
  .j360__lines { position: absolute; left: 0; right: 0; bottom: 8svh; text-align: center; padding: 0 16px; }
  @media screen and (min-width: 990px) {
    .j360__lines { left: 5vw; right: auto; bottom: auto; top: 50%; transform: translateY(-50%); text-align: left; width: 28vw; }
    .j360__eyebrow::after { display: none; }
    .j360__stack { place-items: start; }
    .j360__line { font-size: clamp(3.2rem, 3.4vw, 5.4rem); }
    .j360__shade { background: linear-gradient(180deg, #050307 0%, rgba(5,3,7,0) 18%, rgba(5,3,7,0) 75%, #050307 100%), linear-gradient(90deg, rgba(5,3,7,.85) 0%, rgba(5,3,7,0) 38%); }
  }
  .j360__eyebrow { display: inline-flex; align-items: center; gap: 12px; margin: 0 0 10px; font-size: 1.2rem; font-weight: 600; letter-spacing: .24em; text-transform: uppercase; color: #C9CFDA; }
  .j360__eyebrow::before, .j360__eyebrow::after { content: ""; width: 28px; height: 3px; border-radius: 999px; background: linear-gradient(90deg, #E9489F 0%, #8B5CF6 50%, #4FA8F5 100%); }
  .j360__stack { display: grid; place-items: center; }
  .j360__line { grid-area: 1 / 1; margin: 0; color: #fff; font-family: var(--font-heading-family); font-weight: 700; letter-spacing: -0.03em; line-height: 1.05;
    font-size: clamp(3rem, 4.6vw, 6.6rem); max-width: 20ch;
    opacity: 0; transform: translateY(20px); filter: blur(8px); transition: opacity .6s ease, transform .8s cubic-bezier(.22,1,.36,1), filter .6s ease; }
  .j360__line em { font-style: italic; background: linear-gradient(90deg, #FF7AC8, #A98BFF 50%, #7CC4FF); -webkit-background-clip: text; background-clip: text; color: transparent; padding-right: .08em; }
  .j360__line.is-on { opacity: 1; transform: none; filter: none; }
  .j360__bar { position: absolute; left: 50%; bottom: 3svh; width: min(220px, 40vw); height: 2px; transform: translateX(-50%); background: rgba(255,255,255,.18); border-radius: 2px; overflow: hidden; }
  .j360__bar span { display: block; height: 100%; width: 100%; background: linear-gradient(90deg, #E9489F 0%, #8B5CF6 50%, #4FA8F5 100%); transform-origin: left; transform: scaleX(var(--p, 0)); }
  @media (prefers-reduced-motion: reduce) {
    .j360 { height: auto; } .j360__stage { position: relative; }
    .j360__canvas, .j360__bar { display: none; } .j360__line[data-l="1"] { opacity: 1; transform: none; filter: none; }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('j360-{{ section.id }}');
    if (!root) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var total = Number(root.dataset.frames) || 80;
    var first = root.querySelector('.j360__poster').getAttribute('src');
    // Pantallas verticales (celular) usan la versión vertical del video
    var prefix = window.matchMedia('(max-aspect-ratio: 1/1)').matches ? 'jauiri-360m-' : 'jauiri-360-';
    var canvas = root.querySelector('.j360__canvas'), ctx = canvas.getContext('2d');
    var lines = root.querySelectorAll('.j360__line');
    var imgs = new Array(total), loaded = 0, started = false, current = -1;

    function src(i) { var n = String(i + 1); while (n.length < 3) n = '0' + n; return first.replace('jauiri-360-001.webp', prefix + n + '.webp'); }
    function load() {
      if (started) return; started = true;
      // Primero cada 8° cuadro (para poder mover rápido), luego el resto
      var order = [];
      for (var s = 8; s >= 1; s = Math.floor(s / 2)) for (var i = 0; i < total; i += s) if (order.indexOf(i) < 0) order.push(i);
      order.forEach(function (i) {
        var im = new Image(); im.decoding = 'async';
        im.onload = function () { loaded++; if (!root.classList.contains('is-ready') && imgs[0] && imgs[0].complete) root.classList.add('is-ready'); draw(true); };
        im.src = src(i); imgs[i] = im;
      });
    }
    function size() {
      var dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(canvas.clientWidth * dpr); canvas.height = Math.round(canvas.clientHeight * dpr);
      current = -1; draw(true);
    }
    function nearest(i) {
      for (var d = 0; d < total; d++) {
        var a = imgs[i - d], b = imgs[i + d];
        if (a && a.complete && a.naturalWidth) return a;
        if (b && b.complete && b.naturalWidth) return b;
      }
      return null;
    }
    function progress() {
      var r = root.getBoundingClientRect(), range = root.offsetHeight - window.innerHeight;
      return range > 0 ? Math.min(1, Math.max(0, -r.top / range)) : 0;
    }
    function draw(force) {
      var p = progress();
      root.style.setProperty('--p', p.toFixed(3));
      lines.forEach(function (l) { l.classList.toggle('is-on', (p < 0.5 ? 1 : 2) === Number(l.dataset.l)); });
      var i = Math.min(total - 1, Math.round(p * (total - 1)));
      if (i === current && !force) return;
      var im = nearest(i); if (!im) return;
      current = i;
      var cw = canvas.width, ch = canvas.height, iw = im.naturalWidth, ih = im.naturalHeight;
      var mobile = cw < ch && iw > ih; // video horizontal en pantalla vertical
      // En celular se acerca al frasco (no a todo el cuadro) y se rellena de negro
      var tall = cw < ch && ih > iw; // video vertical en celular: cabe a lo ancho
      var s = mobile ? Math.min(2.4 * cw / iw, ch / ih * 1.05) : tall ? Math.max(cw / iw, ch / ih * 0.86) : Math.max(cw / iw, ch / ih), w = iw * s, h = ih * s;
      ctx.fillStyle = '#050307'; ctx.fillRect(0, 0, cw, ch);
      ctx.drawImage(im, (cw - w) / 2, (ch - h) / 2 - (mobile ? ch * 0.06 : 0), w, h);
      if (mobile || (tall && h < ch)) {
        var y0 = (ch - h) / 2 - (mobile ? ch * 0.06 : 0), fade = h * (mobile ? 0.22 : 0.12);
        var g1 = ctx.createLinearGradient(0, y0, 0, y0 + fade); g1.addColorStop(0, '#050307'); g1.addColorStop(1, 'rgba(5,3,7,0)');
        ctx.fillStyle = g1; ctx.fillRect(0, y0 - 1, cw, fade + 1);
        var g2 = ctx.createLinearGradient(0, y0 + h - fade, 0, y0 + h); g2.addColorStop(0, 'rgba(5,3,7,0)'); g2.addColorStop(1, '#050307');
        ctx.fillStyle = g2; ctx.fillRect(0, y0 + h - fade, cw, fade + 1);
      }
    }
    var ticking = false;
    window.addEventListener('scroll', function () { if (!ticking) { ticking = true; requestAnimationFrame(function () { ticking = false; draw(false); }); } }, { passive: true });
    window.addEventListener('resize', size);
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (e) { if (e[0].isIntersecting) load(); }, { rootMargin: '150% 0px' }).observe(root);
    } else { load(); }
    size();
  })();
</script>

{% schema %}
{
  "name": "Jauiri 360°",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño", "default": "360°" },
    { "type": "inline_richtext", "id": "line_1", "label": "Frase 1", "default": "Míralo desde <em>todos los ángulos</em>." },
    { "type": "inline_richtext", "id": "line_2", "label": "Frase 2", "default": "Ábrelo. <em>Empieza tu rutina.</em>" },
    { "type": "range", "id": "frames", "label": "Número de cuadros", "min": 10, "max": 200, "step": 10, "default": 80 }
  ],
  "presets": [ { "name": "Jauiri 360°" } ]
}
{% endschema %}
