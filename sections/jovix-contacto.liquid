{%- comment -%}
  DFH JOVIX · Página de contacto
  Columna izquierda: quiénes somos y cómo escribirnos (correo directo).
  Columna derecha: formulario. Los mensajes llegan al correo de la tienda (hola@dfhjovix.com).
{%- endcomment -%}

{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}

<section class="jct" aria-labelledby="jct-title-{{ section.id }}">
  <div class="jct__hero">
    <div class="jct__wrap page-width">
      <div class="jct__intro">
        {%- if section.settings.eyebrow != blank -%}
          <p class="jct__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h1 id="jct-title-{{ section.id }}" class="jct__title">{{ section.settings.heading }}</h1>
        {%- if section.settings.text != blank -%}
          <div class="jct__text">{{ section.settings.text }}</div>
        {%- endif -%}

        <ul class="jct__list" role="list">
          {%- if section.settings.email != blank -%}
            <li class="jct__item">
              <span class="jct__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m4 7 8 6 8-6"/></svg>
              </span>
              <div>
                <span class="jct__label">Correo</span>
                <a class="jct__value" href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
              </div>
            </li>
          {%- endif -%}
          {%- for block in section.blocks -%}
            <li class="jct__item" {{ block.shopify_attributes }}>
              <span class="jct__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12a8 8 0 1 1-8-8"/><path d="m9 11 3 3 8-8"/></svg>
              </span>
              <div>
                <span class="jct__label">{{ block.settings.label | escape }}</span>
                {%- if block.settings.link != blank -%}
                  <a class="jct__value" href="{{ block.settings.link }}">{{ block.settings.value | escape }}</a>
                {%- else -%}
                  <span class="jct__value jct__value--plain">{{ block.settings.value | escape }}</span>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ul>
      </div>

      <div class="jct__card">
        <h2 class="jct__card-title">{{ section.settings.form_heading | escape }}</h2>
        {%- form 'contact', id: 'ContactForm', class: 'jct__form isolate' -%}
          {%- if form.posted_successfully? -%}
            <p class="jct__status jct__status--ok" tabindex="-1" autofocus role="status">
              {{ section.settings.success_text | escape }}
            </p>
          {%- elsif form.errors -%}
            <p class="jct__status jct__status--error" tabindex="-1" autofocus role="alert">
              Revisa tu correo electrónico: {{ form.errors.messages.email }}
            </p>
          {%- endif -%}

          <div class="jct__row">
            <div class="field">
              <input class="field__input" autocomplete="name" type="text" id="ContactForm-name" name="contact[Nombre]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" placeholder="Nombre">
              <label class="field__label" for="ContactForm-name">Nombre</label>
            </div>
            <div class="field">
              <input class="field__input" autocomplete="email" type="email" id="ContactForm-email" name="contact[email]" spellcheck="false" autocapitalize="off" required aria-required="true" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" placeholder="Correo electrónico"{% if form.errors contains 'email' %} aria-invalid="true"{% endif %}>
              <label class="field__label" for="ContactForm-email">Correo electrónico <span aria-hidden="true">*</span></label>
            </div>
          </div>

          <div class="jct__group">
            <label class="jct__select-label" for="ContactForm-topic">¿Sobre qué nos escribes?</label>
            <select class="jct__select" id="ContactForm-topic" name="contact[Tema]">
              <option>Dudas sobre Jauiri</option>
              <option>Mi pedido</option>
              <option>Envíos</option>
              <option>Ventas al mayoreo</option>
              <option>Otro</option>
            </select>
          </div>

          <div class="field">
            <input class="field__input" type="tel" id="ContactForm-phone" autocomplete="tel" name="contact[Teléfono]" pattern="[0-9\-\s\+]*" value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}" placeholder="Teléfono (opcional)">
            <label class="field__label" for="ContactForm-phone">Teléfono (opcional)</label>
          </div>

          <div class="field">
            <textarea rows="6" id="ContactForm-body" class="text-area field__input" name="contact[Mensaje]" placeholder="Mensaje">{{- form.body -}}</textarea>
            <label class="form__label field__label" for="ContactForm-body">Mensaje</label>
          </div>

          <button type="submit" class="jct__submit">Enviar mensaje</button>
          <p class="jct__fine">Usamos tus datos solo para responderte. Consulta nuestra <a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}">política de privacidad</a>.</p>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

<style>
  .jct__hero { position: relative; background: #17273A; color: #fff; overflow: hidden; }
  .jct__hero::before { content: ""; position: absolute; inset: 0; pointer-events: none;
    background:
      radial-gradient(60% 70% at 18% 20%, rgba(200,147,49,.18), rgba(200,147,49,0) 70%),
      radial-gradient(50% 60% at 95% 100%, rgba(31,78,107,.55), rgba(31,78,107,0) 70%); }
  .jct__wrap { position: relative; display: grid; grid-template-columns: 1fr; gap: 40px; padding-top: 56px; padding-bottom: 64px; }
  @media screen and (min-width: 990px) {
    .jct__wrap { grid-template-columns: 1fr 1.05fr; gap: 72px; align-items: start; padding-top: 96px; padding-bottom: 110px; }
  }

  .jct__eyebrow { display: inline-flex; align-items: center; gap: 12px; margin: 0 0 18px; font-size: 1.2rem; font-weight: 600; letter-spacing: .22em; text-transform: uppercase; color: #EBC673; }
  .jct__eyebrow::before { content: ""; width: 28px; height: 3px; border-radius: 999px; background: #C89331; }
  .jct__title { margin: 0; color: #fff; font-family: var(--font-heading-family); font-weight: 700; letter-spacing: -0.03em; line-height: 1.02; font-size: clamp(3.6rem, 5vw, 6.4rem); }
  .jct__title em { font-style: italic; color: #EBC673; }
  .jct__text { margin-top: 20px; max-width: 46ch; font-size: 1.7rem; line-height: 1.6; color: rgba(255,255,255,.86); }
  .jct__text p { margin: 0 0 1em; } .jct__text p:last-child { margin-bottom: 0; }

  .jct__list { margin: 36px 0 0; padding: 0; display: grid; gap: 14px; max-width: 46rem; }
  .jct__item { display: flex; gap: 16px; align-items: center; padding: 16px 18px; border-radius: 14px; background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.12); }
  .jct__icon { flex: none; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 12px; background: rgba(200,147,49,.16); color: #EBC673; }
  .jct__label { display: block; font-size: 1.15rem; letter-spacing: .14em; text-transform: uppercase; color: rgba(255,255,255,.7); margin-bottom: 2px; }
  .jct__value { font-size: 1.7rem; font-weight: 600; color: #fff; text-decoration: underline; text-decoration-color: rgba(235,198,115,.6); text-underline-offset: 4px; word-break: break-word; }
  .jct__value:hover { text-decoration-color: #EBC673; }
  .jct__value--plain { text-decoration: none; font-weight: 500; }

  .jct__card { background: #fff; color: #17273A; border-radius: 20px; padding: 28px 22px; box-shadow: 0 40px 80px -40px rgba(0,0,0,.6); }
  @media screen and (min-width: 750px) { .jct__card { padding: 40px; } }
  .jct__card-title { margin: 0 0 22px; font-family: var(--font-heading-family); font-size: 2.4rem; font-weight: 700; letter-spacing: -0.02em; color: #17273A; }
  .jct__form .field { margin-bottom: 14px; }
  .jct__row { display: grid; gap: 0 14px; }
  @media screen and (min-width: 750px) { .jct__row { grid-template-columns: 1fr 1fr; } }
  .jct__form .field__input, .jct__form .text-area { color: #17273A; }
  .jct__group { margin-bottom: 14px; }
  .jct__select-label { display: block; font-size: 1.3rem; color: rgba(23,39,58,.75); margin: 2px 0 6px 2px; }
  .jct__select { width: 100%; min-height: 4.6rem; padding: 0 14px; border-radius: 12px; border: 1px solid rgba(23,39,58,.35); background: #fff; color: #17273A; font: inherit; font-size: 1.6rem; }
  .jct__select:focus-visible { outline: 2px solid #1F4E6B; outline-offset: 2px; }
  .jct__submit { width: 100%; min-height: 54px; margin-top: 6px; border: 0; border-radius: 12px; background: #1F4E6B; color: #fff; font: inherit; font-size: 1.6rem; font-weight: 700; cursor: pointer; transition: background .2s ease, transform .2s ease; }
  .jct__submit:hover { background: #17273A; transform: translateY(-1px); }
  .jct__submit:focus-visible { outline: 2px solid #C89331; outline-offset: 3px; }
  .jct__fine { margin: 14px 0 0; font-size: 1.25rem; line-height: 1.5; color: rgba(23,39,58,.72); }
  .jct__fine a { color: #1F4E6B; }
  .jct__status { margin: 0 0 18px; padding: 12px 14px; border-radius: 12px; font-size: 1.5rem; }
  .jct__status--ok { background: #EAF4EE; color: #1E5B37; }
  .jct__status--error { background: #FBECEC; color: #8A1F1F; }
</style>

{% schema %}
{
  "name": "Contacto DFH JOVIX",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto superior", "default": "Contacto" },
    { "type": "inline_richtext", "id": "heading", "label": "Título", "default": "Estamos para <em>resolver tus dudas</em>." },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Escríbenos sobre Jauiri, tu pedido o tu envío y te respondemos por correo.</p>" },
    { "type": "text", "id": "email", "label": "Correo de contacto", "default": "hola@dfhjovix.com" },
    { "type": "text", "id": "form_heading", "label": "Título del formulario", "default": "Envíanos un mensaje" },
    { "type": "text", "id": "success_text", "label": "Mensaje al enviar", "default": "Gracias por escribirnos. Te responderemos a tu correo muy pronto." }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Dato de contacto",
      "settings": [
        { "type": "text", "id": "label", "label": "Etiqueta", "default": "Preguntas frecuentes" },
        { "type": "text", "id": "value", "label": "Texto", "default": "Antes de empezar con Jauiri" },
        { "type": "url", "id": "link", "label": "Enlace" }
      ]
    }
  ],
  "presets": [{ "name": "Contacto DFH JOVIX" }]
}
{% endschema %}
