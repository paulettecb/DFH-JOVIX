{%- comment -%}
  DFH JOVIX · Ingredientes en scroll
  Imagen grande del producto que se queda fija mientras bajas; los
  ingredientes van apareciendo alrededor del frasco, uno por uno.
  Escritorio: ingredientes a los lados del frasco con línea y punto.
  Móvil: imagen arriba y los ingredientes aparecen debajo.
{%- endcomment -%}

{%- liquid
  assign total = section.blocks.size
  assign steps = total | plus: 2
-%}

<section
  id="jv-spot-{{ section.id }}"
  class="jv-spot"
  style="--jv-steps: {{ steps }};"
  data-jv-spot
>
  <div class="jv-spot__sticky">
    <div class="jv-spot__head">
      {%- if section.settings.caption != blank -%}
        <p class="jv-spot__caption">{{ section.settings.caption | escape }}</p>
      {%- endif -%}
      <h2 class="jv-spot__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="jv-spot__sub">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="jv-spot__stage">
      <div class="jv-spot__frame">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 2400
            | image_tag: class: 'jv-spot__img', loading: 'eager', sizes: '100vw', alt: section.settings.image.alt
          }}
        {%- else -%}
          <img
            class="jv-spot__img"
            src="{{ 'jauiri-hero.webp' | asset_url }}"
            width="1280"
            height="720"
            alt="Frasco de Jauiri de DFH JOVIX con cápsulas"
            loading="eager"
          >
        {%- endif -%}

        <ul class="jv-spot__list" role="list">
          {%- assign left_i = 0 -%}
          {%- assign right_i = 0 -%}
          {%- for block in section.blocks -%}
            {%- liquid
              if block.settings.side == 'left'
                assign row = left_i
                assign left_i = left_i | plus: 1
              else
                assign row = right_i
                assign right_i = right_i | plus: 1
              endif
            -%}
            <li
              class="jv-spot__item jv-spot__item--{{ block.settings.side }}"
              style="--row: {{ row }};"
              data-jv-step="{{ forloop.index }}"
              {{ block.shopify_attributes }}
            >
              <span class="jv-spot__dot" aria-hidden="true"></span>
              <span class="jv-spot__line" aria-hidden="true"></span>
              <span class="jv-spot__txt">
                <strong>{{ block.settings.name | escape }}</strong>
                {%- if block.settings.text != blank -%}<span>{{ block.settings.text | escape }}</span>{%- endif -%}
              </span>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="jv-spot__cta" data-jv-step="{{ total | plus: 1 }}">
        <a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
          {{- section.settings.button_label | escape -}}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% style %}
  #jv-spot-{{ section.id }} { --jv-bg: {{ section.settings.background }}; }
{% endstyle %}

<style>
  .jv-spot {
    position: relative;
    height: calc(var(--jv-steps) * 35vh + 100vh);
    background: var(--jv-bg, #0B0812);
    color: #fff;
  }
  .jv-spot__sticky {
    position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    padding: 24px 16px;
  }
  .jv-spot__head { text-align: center; position: relative; z-index: 2; margin-bottom: 8px; }
  .jv-spot__caption {
    display: inline-flex; align-items: center; gap: 12px; margin: 0 0 8px;
    font-size: 1.2rem; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; color: #C9CFDA;
  }
  .jv-spot__caption::before { content: ""; width: 28px; height: 3px; border-radius: 999px; background: linear-gradient(90deg, #E9489F 0%, #8B5CF6 50%, #4FA8F5 100%); }
  .jv-spot__title {
    margin: 0; color: #fff; font-family: var(--font-heading-family); font-weight: 700;
    font-size: clamp(4rem, 7vw, 8rem); line-height: 1; letter-spacing: -0.02em;
  }
  .jv-spot__sub { margin: 8px 0 0; font-size: clamp(1.5rem, 1.6vw, 1.9rem); color: rgba(255,255,255,.78); }

  .jv-spot__stage { position: relative; width: 100%; display: flex; justify-content: center; }
  .jv-spot__frame {
    position: relative;
    width: min(100%, calc((100svh - 290px) * 16 / 9), 1500px);
    aspect-ratio: 16 / 9;
  }
  .jv-spot__img {
    width: 100%; height: 100%; object-fit: cover; display: block; border-radius: 20px;
    transform: scale(var(--jv-zoom, 1.08)); transition: transform .6s cubic-bezier(.22,1,.36,1);
    -webkit-mask-image: radial-gradient(120% 120% at 50% 50%, #000 62%, transparent 100%);
            mask-image: radial-gradient(120% 120% at 50% 50%, #000 62%, transparent 100%);
  }

  /* Ingredientes (escritorio): a los lados del frasco */
  .jv-spot__list { list-style: none; margin: 0; padding: 0; position: absolute; inset: 0; pointer-events: none; }
  .jv-spot__item {
    position: absolute; top: calc(18% + var(--row) * 19%);
    display: flex; align-items: center; gap: 0;
    opacity: 0; transition: opacity .5s ease, transform .6s cubic-bezier(.22,1,.36,1);
  }
  .jv-spot__item--left  { right: 66%; flex-direction: row-reverse; transform: translateX(-18px); text-align: right; }
  .jv-spot__item--right { left: 66%; transform: translateX(18px); }
  .jv-spot__item.is-on { opacity: 1; transform: none; }
  .jv-spot__dot { width: 10px; height: 10px; border-radius: 50%; background: #fff; box-shadow: 0 0 0 4px rgba(233,72,159,.45); flex: none; }
  .jv-spot__line { width: clamp(28px, 4vw, 64px); height: 1.5px; background: rgba(255,255,255,.75); flex: none; }
  .jv-spot__txt { display: flex; flex-direction: column; padding: 0 12px; max-width: 22ch; text-shadow: 0 2px 12px rgba(0,0,0,.6); }
  .jv-spot__txt strong { font-size: clamp(1.5rem, 1.35vw, 2rem); font-weight: 700; color: #fff; line-height: 1.2; }
  .jv-spot__txt span { font-size: clamp(1.25rem, 1.05vw, 1.55rem); color: rgba(255,255,255,.78); line-height: 1.35; margin-top: 2px; }

  .jv-spot__cta { margin-top: 18px; opacity: 0; transform: translateY(12px); transition: opacity .5s ease, transform .6s cubic-bezier(.22,1,.36,1); }
  .jv-spot__cta.is-on { opacity: 1; transform: none; }

  /* Móvil: imagen arriba, ingredientes debajo en dos columnas */
  @media screen and (max-width: 749px) {
    .jv-spot { height: calc(var(--jv-steps) * 30vh + 100vh); }
    .jv-spot__sticky { justify-content: flex-start; padding-top: 56px; }
    .jv-spot__frame { width: 100%; aspect-ratio: 5 / 4; }
    .jv-spot__img { -webkit-mask-image: none; mask-image: none; }
    .jv-spot__list {
      position: static; display: grid; grid-template-columns: 1fr 1fr; gap: 14px 16px; margin-top: 18px;
    }
    .jv-spot__item, .jv-spot__item--left, .jv-spot__item--right {
      position: static; flex-direction: row; text-align: left; transform: translateY(10px);
      align-items: flex-start;
    }
    .jv-spot__item.is-on { transform: none; }
    .jv-spot__line { display: none; }
    .jv-spot__dot { margin-top: 5px; width: 8px; height: 8px; }
    .jv-spot__txt { padding: 0 0 0 10px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .jv-spot { height: auto; }
    .jv-spot__sticky { position: relative; height: auto; padding: 56px 16px; }
    .jv-spot__item, .jv-spot__cta { opacity: 1; transform: none; transition: none; }
    .jv-spot__img { transform: none; transition: none; }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('jv-spot-{{ section.id }}');
    if (!root) return;
    var steps = Array.prototype.slice.call(root.querySelectorAll('[data-jv-step]'));
    var img = root.querySelector('.jv-spot__img');
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var inEditor = window.Shopify && window.Shopify.designMode;

    function showAll() { steps.forEach(function (el) { el.classList.add('is-on'); }); }
    if (reduce || inEditor) { showAll(); if (!inEditor) return; }

    var total = steps.length;
    var ticking = false;
    function update() {
      ticking = false;
      var rect = root.getBoundingClientRect();
      var range = root.offsetHeight - window.innerHeight;
      var p = range > 0 ? Math.min(1, Math.max(0, -rect.top / range)) : 1;
      var count = Math.floor(p * (total + 0.999));
      steps.forEach(function (el) {
        el.classList.toggle('is-on', Number(el.dataset.jvStep) <= count);
      });
      if (img) img.style.setProperty('--jv-zoom', String(1.08 - 0.08 * p));
    }
    function onScroll() { if (!ticking) { ticking = true; requestAnimationFrame(update); } }
    if (!inEditor) {
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      update();
    }
  })();
</script>

{% schema %}
{
  "name": "Ingredientes en scroll",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen (si no eliges una, se usa la del frasco)" },
    { "type": "text", "id": "caption", "label": "Texto pequeño", "default": "DFH JOVIX" },
    { "type": "inline_richtext", "id": "heading", "label": "Título", "default": "Jauiri" },
    { "type": "inline_richtext", "id": "subheading", "label": "Subtítulo", "default": "Ocho ingredientes, un solo propósito." },
    { "type": "color", "id": "background", "label": "Fondo", "default": "#0B0812" },
    { "type": "text", "id": "button_label", "label": "Botón", "default": "Quiero mi Jauiri" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingrediente",
      "limit": 10,
      "settings": [
        { "type": "text", "id": "name", "label": "Nombre", "default": "Ingrediente" },
        { "type": "text", "id": "text", "label": "Para qué sirve" },
        {
          "type": "select",
          "id": "side",
          "label": "Lado",
          "options": [
            { "value": "left", "label": "Izquierda" },
            { "value": "right", "label": "Derecha" }
          ],
          "default": "left"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ingredientes en scroll",
      "blocks": [
        { "type": "ingredient", "settings": { "name": "Cola de caballo", "text": "Silicio natural", "side": "left" } },
        { "type": "ingredient", "settings": { "name": "Biotina", "text": "La vitamina del cabello", "side": "right" } }
      ]
    }
  ]
}
{% endschema %}
