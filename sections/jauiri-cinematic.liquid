{%- comment -%}
  DFH JOVIX · Banner cinematográfico
  Imagen a pantalla completa que hace zoom lento al bajar, con el texto
  apareciendo línea por línea. Para escenas de detalle o resultado.
{%- endcomment -%}

<section id="jvc-{{ section.id }}" class="jvc jvc--{{ section.settings.align }}" data-jvc>
  <div class="jvc__media">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: class: 'jvc__img', loading: 'lazy', sizes: '100vw', alt: section.settings.image.alt }}
    {%- elsif section.settings.fallback != blank -%}
      <picture>
        {%- if section.settings.fallback_mobile != blank -%}<source media="(max-width: 749px)" srcset="{{ section.settings.fallback_mobile | asset_url }}">{%- endif -%}
        <img class="jvc__img" src="{{ section.settings.fallback | asset_url }}" alt="{{ section.settings.alt | escape }}" width="1672" height="941" loading="lazy">
      </picture>
    {%- endif -%}
  </div>
  <div class="jvc__shade" aria-hidden="true"></div>
  <div class="jvc__content page-width">
    <div class="jvc__box">
      {%- if section.settings.eyebrow != blank -%}<p class="jvc__eyebrow jvc__r">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="jvc__title jvc__r">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="jvc__text jvc__r">{{ section.settings.text }}</div>{%- endif -%}
    </div>
  </div>
</section>

<style>
  .jvc { position: relative; min-height: 115vh; min-height: 115svh; overflow: hidden; background: #07050C; color: #fff; display: flex; align-items: center; }
  .jvc__media { position: absolute; inset: 0; }
  .jvc__img { width: 100%; height: 100%; object-fit: cover; display: block; transform: scale(var(--z, 1.2)) translate3d(0, var(--y, 0), 0); will-change: transform; }
  .jvc__shade { position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(180deg, #07050C 0%, rgba(7,5,12,0) 18%, rgba(7,5,12,0) 70%, #07050C 100%); }
  .jvc--left .jvc__shade { background: linear-gradient(180deg, #07050C 0%, rgba(7,5,12,0) 18%, rgba(7,5,12,0) 70%, #07050C 100%), linear-gradient(90deg, rgba(7,5,12,.85) 0%, rgba(7,5,12,.3) 45%, rgba(7,5,12,0) 70%); }
  .jvc--right .jvc__shade { background: linear-gradient(180deg, #07050C 0%, rgba(7,5,12,0) 18%, rgba(7,5,12,0) 70%, #07050C 100%), linear-gradient(270deg, rgba(7,5,12,.85) 0%, rgba(7,5,12,.3) 45%, rgba(7,5,12,0) 70%); }
  .jvc__content { position: relative; z-index: 1; width: 100%; display: flex; }
  /* Velo oscuro detrás del texto para que siempre se lea, aunque la foto sea muy clara */
  .jvc__box { position: relative; }
  .jvc__box::before { content: ""; position: absolute; inset: -18% -22%; z-index: -1; pointer-events: none;
    background: radial-gradient(closest-side, rgba(7,5,12,.78), rgba(7,5,12,.5) 55%, rgba(7,5,12,0) 100%); filter: blur(10px); }
  .jvc__title, .jvc__text, .jvc__eyebrow { text-shadow: 0 2px 18px rgba(0,0,0,.65), 0 1px 3px rgba(0,0,0,.5); }
  .jvc__title em { text-shadow: none; filter: drop-shadow(0 2px 12px rgba(0,0,0,.55)); }
  .jvc--right .jvc__content { justify-content: flex-end; }
  .jvc--center .jvc__content { justify-content: center; text-align: center; }
  .jvc__box { max-width: 46rem; }
  .jvc--center .jvc__box { max-width: 62rem; }
  .jvc__eyebrow { display: inline-flex; align-items: center; gap: 12px; margin: 0 0 14px; font-size: 1.2rem; font-weight: 600; letter-spacing: .22em; text-transform: uppercase; color: #C9CFDA; }
  .jvc__eyebrow::before { content: ""; width: 28px; height: 3px; border-radius: 999px; background: linear-gradient(90deg, #E9489F 0%, #8B5CF6 50%, #4FA8F5 100%); }
  .jvc__title { margin: 0; color: #fff; font-family: var(--font-heading-family); font-weight: 700; letter-spacing: -0.03em; line-height: 1.02; font-size: clamp(3.6rem, 5.6vw, 8rem); }
  .jvc__title em { font-style: italic; background: linear-gradient(90deg, #FF7AC8, #A98BFF 50%, #7CC4FF); -webkit-background-clip: text; background-clip: text; color: transparent; padding-right: .08em; }
  .jvc__text { margin-top: 18px; font-size: clamp(1.6rem, 1.4vw, 2rem); line-height: 1.6; color: rgba(255,255,255,.82); }
  .jvc__text p { margin: 0; }
  .jvc__r { opacity: 0; transform: translateY(26px); filter: blur(8px); transition: opacity .9s ease, transform 1.1s cubic-bezier(.22,1,.36,1), filter .9s ease; }
  .jvc__r:nth-child(2) { transition-delay: .12s; } .jvc__r:nth-child(3) { transition-delay: .24s; }
  .jvc.is-in .jvc__r { opacity: 1; transform: none; filter: none; }
  @media screen and (max-width: 749px) {
    .jvc { align-items: flex-end; padding-bottom: 14svh; }
    .jvc--left .jvc__shade, .jvc--right .jvc__shade { background: linear-gradient(180deg, #07050C 0%, rgba(7,5,12,0) 20%, rgba(7,5,12,.2) 50%, rgba(7,5,12,.92) 85%, #07050C 100%); }
    .jvc--right .jvc__content { justify-content: flex-start; }
    .jvc__img { object-position: var(--mpos, 50% 50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .jvc__img { transform: none; } .jvc__r { opacity: 1; transform: none; filter: none; transition: none; }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('jvc-{{ section.id }}');
    if (!root) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) { root.classList.add('is-in'); return; }
    var img = root.querySelector('.jvc__img');
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (e) { e.forEach(function (x) { if (x.isIntersecting) root.classList.add('is-in'); }); }, { threshold: 0.35 }).observe(root);
    } else { root.classList.add('is-in'); }
    var ticking = false;
    function update() {
      ticking = false;
      var r = root.getBoundingClientRect(), vh = window.innerHeight;
      var t = Math.min(1, Math.max(0, (vh - r.top) / (vh + r.height)));
      if (img) { img.style.setProperty('--z', (1.22 - 0.2 * t).toFixed(4)); img.style.setProperty('--y', ((t - 0.5) * -6).toFixed(2) + 'vh'); }
    }
    window.addEventListener('scroll', function () { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    update();
  })();
</script>

{% schema %}
{
  "name": "Banner cinematográfico",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    { "type": "text", "id": "fallback", "label": "Imagen del tema (nombre de archivo)", "info": "Se usa si no eliges imagen." },
    { "type": "text", "id": "fallback_mobile", "label": "Imagen del tema para celular (opcional)" },
    { "type": "text", "id": "alt", "label": "Descripción de la imagen" },
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño" },
    { "type": "inline_richtext", "id": "heading", "label": "Título", "default": "Título" },
    { "type": "richtext", "id": "text", "label": "Texto" },
    {
      "type": "select", "id": "align", "label": "Posición del texto", "default": "left",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Derecha" }
      ]
    }
  ],
  "presets": [ { "name": "Banner cinematográfico" } ]
}
{% endschema %}
